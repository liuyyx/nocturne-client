# Build output
build/
*/build/
.gradle/
target/

# Tooling / scratch
tmp/
*.log

# Vendored Setsuna (照抄的第三方源码) 的隔离编译探针工程：
# 其中的 Fabric 模块 jar 是从 mods 里的 fat jar 拆出来的编译期依赖，不入库（见该目录 build.gradle.kts）。
vendor/setsuna-gui/libs/
vendor/setsuna-gui/build/
vendor/setsuna-gui/.gradle/

# Vendored Vape（CC0 照抄源码）的隔离编译探针产物；源码本身要入库。
vendor/vape/build/
vendor/vape/.gradle/

# .NET launcher
launcher/bin/
launcher/obj/

# MSVC 原生编译中间产物（cl 的默认输出：对象/导入库/导出表）
*.obj
*.lib
*.exp

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Keep the shipped mapping data (source asset, not build output)
!client/src/main/resources/mappings-*.json
